---
import Layout from "../../layouts/Layout.astro";
import { posts } from "../../data/posts";

const externalLinkAttrs = {
  target: "_blank",
  rel: "noopener noreferrer",
};
---

<Layout
  title="Posts - Harald Bregu"
  description="Technical posts by Harald Bregu on Swift, iOS, architecture, and software development."
  url="https://haraldbregu.com/posts/"
>
  <main>
    <header class="site">
      <div class="top">
        <a class="mark" href="/"><span class="glyph" aria-hidden="true"></span>hb</a>
        <span class="crumbs">~<span class="sep">/</span>portfolio<span class="sep">/</span>posts</span>
        <span>writing</span>
      </div>

      <div class="id-row">
        <div class="id">
          <h1 class="name">posts<span class="caret" aria-hidden="true"></span></h1>
          <div class="role">
            <span>technical notes</span>
            <span class="pipe">/</span>
            <span>swift, ios &amp; architecture</span>
          </div>
          <div class="theme-toggle" role="group" aria-label="Theme">
            <button data-set-theme="light" aria-pressed="true">light</button>
            <button data-set-theme="dark" aria-pressed="false">dark</button>
          </div>
        </div>

        <div class="meta">
          <div><a href="/">home</a></div>
          <div class="where">
            <a href="https://github.com/HaraldBregu" {...externalLinkAttrs}>github</a>
            / writing archive
          </div>
        </div>
      </div>
    </header>

    <section class="posts-index" id="posts">
      <h2 class="sec-label"><span class="num">00</span><span>all posts</span></h2>
      <div class="rows">
        {
          posts.map((post) => (
            <article class="row blog-row">
              <div class="when">{post.when}</div>
              <div class="what">
                <a class="title" href={post.href}>{post.title}</a>
                <span class="read">{post.excerpt}</span>
                <div class="tags" aria-label={`${post.title} tags`}>
                  {post.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </div>
              <div class="aside">{post.read}</div>
            </article>
          ))
        }
      </div>
    </section>

    <footer class="site">
      <div>© 2026 harald bregu</div>
      <div class="links">
        <a href="/">home</a>
        <a href="/#contact">contact</a>
      </div>
    </footer>
  </main>

  <style>
    .top a.mark {
      border-bottom: 0;
    }

    .posts-index .title {
      border-bottom: 0;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }

    .tags span {
      border: 1px solid var(--rule);
      border-radius: 2px;
      color: var(--fg-mute);
      font-size: 11px;
      line-height: 1.5;
      padding: 1px 6px;
      background: var(--bg-sub);
    }
  </style>
</Layout>
