---

<Layout title="Harald Bregu — Portfolio" description={profile.description}>
  <main>
    <header class="site">
      <div class="top">
        <span class="mark"><span class="glyph" aria-hidden="true"></span>{profile.mark}</span>
        <span class="crumbs">~<span class="sep">/</span>portfolio<span class="sep">/</span>index</span>
        <span class="top-right">
          <a class="nav-link" href={friday.href} {...externalLinkAttrs}>{friday.name} <span class="arrow">-&gt;</span></a>
          <span>v.2026.05</span>
        </span>
      </div>

      <div class="id-row">
        <div class="id">
          <h1 class="name">{profile.name.toLowerCase()}<span class="caret" aria-hidden="true"></span></h1>
          <div class="role">
            <span>senior lead developer</span>
            <span class="pipe">/</span>
            <span>desktop, web &amp; mobile</span>
            <span class="tag">cross-platform</span>
          </div>
          <div class="theme-toggle" role="group" aria-label="Theme">
            <button data-set-theme="light" aria-pressed="true">light</button>
            <button data-set-theme="dark" aria-pressed="false">dark</button>
          </div>
        </div>

        <div class="meta">
          <div class="status"><span class="dot"></span><span>available · professional inquiries</span></div>
          <div class="where"><a href={profile.locationHref} {...externalLinkAttrs}>{profile.location}</a> / remote</div>
        </div>
      </div>
    </header>

    <section class="intro" id="about">
      <h2 class="sec-label"><span class="num">00</span><span>about</span></h2>
      <p>{profile.description}</p>
      <p>
        I'm currently building <a href={friday.href} {...externalLinkAttrs}>Friday</a>, a local-first AI personal
        assistant that turns plain language into real work — files, commands, web research, and media generation, all
        with your own provider keys.
      </p>
      <p class="muted">{profile.summary}</p>
    </section>

    <section id="skills">
      <h2 class="sec-label"><span class="num">01</span><span>skills</span></h2>
      <div class="skill-list" aria-label="Skills">
        {skills.map((skill) => <span class="skill">{skill}</span>)}
      </div>
    </section>

    <section id="work">
      <h2 class="sec-label"><span class="num">02</span><span>activities</span></h2>
      <div class="rows">
        {
          work.map((item) => (
            <div class="row">
              <div class="when">{item.when}</div>
              <div class="what">
                {item.role}<span class="org">/ {item.org}</span>
                <span class="desc">{item.desc}</span>
              </div>
              <div class="aside">{item.aside}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="projects">
      <h2 class="sec-label"><span class="num">03</span><span>projects</span></h2>
      <div class="rows">
        {
          projects.map((project) => (
            <div class="row proj-row">
              <div class="when">{project.when}</div>
              <div class="what">
                <div class="head">
                  <a class="title" href={project.href} {...externalLinkAttrs}>
                    {project.name} <span class="arrow">-&gt;</span>
                  </a>
                </div>
                <span class="desc">{project.desc}</span>
              </div>
              <div class="aside">
                <span class="stars">{project.stat}</span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="services">
      <h2 class="sec-label"><span class="num">04</span><span>services</span></h2>
      <div class="rows">
        {
          services.map((service) => (
            <div class="row proj-row">
              <div class="when">{service.stat}</div>
              <div class="what">
                <div class="head">
                  <span class="title">{service.title}</span>
                </div>
                <span class="desc">{service.desc}</span>
              </div>
              <div class="aside">exp lab 01</div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="writing">
      <h2 class="sec-label"><span class="num">05</span><span>posts</span></h2>
      <div class="rows">
        {
          posts.map((post) => (
            <div class="row blog-row">
              <div class="when">{post.when}</div>
              <div class="what">
                <a class="title" href={post.href}>{post.title}</a>
                <span class="read">{post.read} · {post.date}</span>
              </div>
              <div class="aside">{post.aside}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="contact">
      <h2 class="sec-label"><span class="num">06</span><span>contact</span></h2>
      <dl class="contact-grid">
        <dt>email</dt>
        <dd>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span class="hint">professional inquiries</span>
        </dd>
        <dt>github</dt>
        <dd><a href={profile.github} {...externalLinkAttrs}>github.com/HaraldBregu</a></dd>
        <dt>linkedin</dt>
        <dd><a href={profile.linkedin} {...externalLinkAttrs}>linkedin.com/in/haraldbregu</a></dd>
        <dt>x</dt>
        <dd><a href={profile.x} {...externalLinkAttrs}>x.com/HaraldBregu</a></dd>
      </dl>
    </section>

    <footer class="site">
      <div>© 2026 harald bregu</div>
      <div class="links">
        <a href={friday.href} {...externalLinkAttrs}>friday</a>
        <a href="#about">about</a>
        <a href="#skills">skills</a>
        <a href="#work">activities</a>
        <a href="#projects">projects</a>
        <a href="#services">services</a>
        <a href="/posts/">posts</a>
        <a href="#contact">contact</a>
      </div>
    </footer>
  </main>
</Layout>
