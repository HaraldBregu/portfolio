---
interface Props {
  title: string;
  description?: string;
  url?: string;
  ogType?: string;
  image?: string;
  imageAlt?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = "Harald Bregu, AI-first software engineer building scalable software systems and AI agent workflows.",
  url = "https://haraldbregu.com/",
  ogType = "website",
  image = "/og/default.png",
  imageAlt = title,
  structuredData,
} = Astro.props;

const imageUrl = new URL(image, "https://haraldbregu.com").href;
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : undefined;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="index,follow" />
    <meta name="googlebot" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
    <meta name="bingbot" content="index,follow,max-snippet:-1,max-image-preview:large" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="Harald Bregu" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:creator" content="@HaraldBregu" />
    <meta name="author" content="Harald Bregu" />
    <link rel="canonical" href={url} />
    <link rel="sitemap" type="application/xml" href="https://haraldbregu.com/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Lora:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
  </head>
  <body>
    <slot />

    <style is:global>
      :root {
        --bg: #f6f1e7;
        --bg-sub: #eee8dc;
        --fg: #24221e;
        --fg-mute: #5e5a51;
        --fg-faint: #777267;
        --rule: #ddd6c9;
        --accent: #3e3a32;
        --mark: #e6dfd2;
        --link-underline: #bcb4a6;
        --sans: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --serif: "Lora", Georgia, serif;
      }

      html[data-theme="dark"] {
        --bg: #171715;
        --bg-sub: #22211e;
        --fg: #f3ecdf;
        --fg-mute: #c0b8a9;
        --fg-faint: #938b7d;
        --rule: #37342f;
        --accent: #e2d4b7;
        --mark: #39362f;
        --link-underline: #696154;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--sans);
        font-weight: 400;
        font-size: 16px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        font-feature-settings: "calt" 1, "liga" 1;
        transition:
          background-color 0.2s ease,
          color 0.2s ease;
      }

      ::selection {
        background: var(--mark);
      }

      main {
        max-width: 820px;
        margin: 0 auto;
        padding: 64px 32px 112px;
      }

      header.site {
        margin-bottom: 64px;
      }

      header.site .top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--rule);
        margin-bottom: 22px;
        color: var(--fg-faint);
        font-size: 13px;
        letter-spacing: 0;
        text-transform: none;
      }

      header.site .top .mark {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--fg);
      }

      header.site .top .mark .glyph {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent);
        display: inline-block;
      }

      header.site .top .crumbs {
        color: var(--fg-faint);
      }

      header.site .top .top-right {
        display: inline-flex;
        align-items: center;
        gap: 14px;
      }

      header.site .top .nav-link {
        border-bottom: 0;
        color: var(--fg);
      }

      header.site .top .nav-link .arrow {
        color: var(--fg-faint);
      }

      header.site .top .nav-link:hover,
      header.site .top .nav-link:hover .arrow {
        color: var(--accent);
      }

      header.site .top .crumbs .sep {
        opacity: 0.5;
        padding: 0 4px;
      }

      header.site .id-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
      }

      header.site .id {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
      }

      header.site .name {
        font-family: var(--serif);
        font-weight: 600;
        font-size: 42px;
        line-height: 1.12;
        color: var(--fg);
        margin: 0;
      }

      header.site .name .caret { display: none; }

      header.site .role {
        color: var(--fg-mute);
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }

      header.site .role .pipe {
        color: var(--fg-faint);
      }

      header.site .role .tag {
        border: 1px solid var(--rule);
        padding: 0 6px;
        border-radius: 2px;
        font-size: 11px;
        color: var(--fg-mute);
      }

      header.site .meta {
        color: var(--fg-mute);
        font-size: 12px;
        text-align: right;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      header.site .meta .status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        justify-content: flex-end;
      }

      header.site .meta .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: oklch(64% 0.16 145);
        box-shadow: 0 0 0 3px oklch(64% 0.16 145 / 0.18);
      }

      header.site .meta .where {
        color: var(--fg-faint);
      }

      .theme-toggle {
        display: inline-flex;
        align-self: flex-start;
        border: 1px solid var(--rule);
        border-radius: 999px;
        overflow: hidden;
        margin-top: 8px;
      }

      .theme-toggle button {
        appearance: none;
        background: transparent;
        border: 0;
        padding: 5px 11px;
        font: inherit;
        font-size: 12px;
        color: var(--fg-mute);
        cursor: pointer;
        transition:
          background-color 0.15s ease,
          color 0.15s ease;
      }

      .theme-toggle button[aria-pressed="true"] {
        background: var(--fg);
        color: var(--bg);
      }

      .theme-toggle button:hover:not([aria-pressed="true"]) {
        color: var(--fg);
      }

      section {
        margin: 0 0 64px;
      }

      section:last-of-type {
        margin-bottom: 0;
      }

      .sec-label {
        display: flex;
        align-items: baseline;
        gap: 12px;
        color: var(--accent);
        font-size: 12px;
        font-weight: 700;
        margin: 0 0 20px;
        text-transform: uppercase;
        letter-spacing: 0.09em;
      }

      .sec-label::before {
        content: "";
        flex: 0 0 22px;
        height: 1px;
        background: var(--rule);
        transform: translateY(-3px);
      }

      .sec-label .num {
        display: none;
      }

      .intro p {
        margin: 0 0 14px;
        font-size: 17px;
        line-height: 1.78;
        color: var(--fg);
        max-width: 68ch;
      }

      .intro p:last-child {
        margin-bottom: 0;
      }

      .intro .muted {
        color: var(--fg-mute);
      }

      a {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid var(--link-underline);
        transition:
          border-color 0.15s ease,
          color 0.15s ease;
      }

      a:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }

      .rows {
        display: flex;
        flex-direction: column;
      }

      .skill-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        padding: 16px 0;
      }

      .skill {
        border: 1px solid var(--rule);
        border-radius: 999px;
        color: var(--fg-mute);
        font-size: 13px;
        padding: 4px 10px;
        background: var(--bg-sub);
      }

      .row {
        display: grid;
        grid-template-columns: 72px 1fr auto;
        gap: 18px;
        padding: 14px 0;
        border-top: 1px solid var(--rule);
        align-items: baseline;
      }

      .row:last-child {
        border-bottom: 1px solid var(--rule);
      }

      .row .when {
        color: var(--fg-faint);
        font-size: 12px;
        font-variant-numeric: tabular-nums;
      }

      .row .aside::first-letter,
      .row .when::first-letter,
      .contact-grid dt::first-letter {
        text-transform: uppercase;
      }

      .row .what {
        color: var(--fg);
      }

      .row .what::first-letter,
      .row .what .desc::first-letter,
      .proj-row .title::first-letter {
        text-transform: uppercase;
      }

      .row .what .org {
        color: var(--fg-mute);
        margin-left: 6px;
      }

      .row .what .desc {
        display: block;
        color: var(--fg-mute);
        font-size: 14px;
        margin-top: 4px;
        max-width: 62ch;
      }

      .row .aside {
        color: var(--fg-faint);
        font-size: 12px;
        white-space: nowrap;
      }

      .proj-row a.title {
        border-bottom: 0;
      }

      .proj-row a.title:hover {
        color: var(--accent);
      }

      .proj-row .what {
        display: flex;
        flex-direction: column;
      }

      .proj-row .what .head {
        display: flex;
        align-items: baseline;
        gap: 10px;
        flex-wrap: wrap;
      }

      .proj-row .what .head .arrow {
        color: var(--fg-faint);
        font-size: 11px;
      }

      .stars {
        color: var(--fg-faint);
        font-variant-numeric: tabular-nums;
        font-size: 12px;
      }

      .blog-row .what .read {
        display: block;
        color: var(--fg-mute);
        font-size: 14px;
        margin-top: 4px;
      }

      .contact-grid {
        display: grid;
        grid-template-columns: 72px 1fr;
        gap: 14px 18px;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        padding: 16px 0;
      }

      .contact-grid dt {
        color: var(--fg-faint);
        font-size: 12px;
      }

      .contact-grid dd {
        margin: 0;
        color: var(--fg);
      }

      .contact-grid dd .hint {
        color: var(--fg-mute);
        font-size: 12px;
        margin-left: 8px;
      }

      footer.site {
        margin-top: 72px;
        padding-top: 18px;
        border-top: 1px solid var(--rule);
        display: flex;
        justify-content: space-between;
        gap: 20px;
        color: var(--fg-faint);
        font-size: 12px;
      }

      footer.site .links {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
      }

      footer.site a {
        border-bottom: 0;
        color: var(--fg-mute);
      }

      footer.site a:hover {
        color: var(--accent);
      }

      :focus-visible {
        outline: 3px solid color-mix(in srgb, var(--accent) 55%, transparent);
        outline-offset: 3px;
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }

      @media (max-width: 520px) {
        main {
          padding: 36px 20px 80px;
        }

        header.site {
          margin-bottom: 44px;
        }

        header.site .name {
          font-size: 34px;
        }

        header.site .id-row {
          flex-direction: column;
          align-items: flex-start;
          gap: 12px;
        }

        header.site .meta {
          text-align: left;
          align-items: flex-start;
        }

        header.site .meta .status {
          justify-content: flex-start;
        }

        header.site .top .crumbs {
          display: none;
        }

        .row {
          grid-template-columns: 60px 1fr;
        }

        .row .aside {
          grid-column: 2;
          padding-left: 0;
        }

        .contact-grid {
          grid-template-columns: 64px 1fr;
        }

        footer.site {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const stored = localStorage.getItem("theme");
        const prefersDark =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        const initial =
          stored === "ink" || stored === "dark"
            ? "dark"
            : stored === "paper" || stored === "light"
              ? "light"
              : prefersDark
                ? "dark"
                : "light";

        const setTheme = (theme) => {
          root.setAttribute("data-theme", theme);
          localStorage.setItem("theme", theme);
          document.querySelectorAll("[data-set-theme]").forEach((button) => {
            button.setAttribute(
              "aria-pressed",
              String(button.dataset.setTheme === theme),
            );
          });
        };

        setTheme(initial);

        document.querySelectorAll("[data-set-theme]").forEach((button) => {
          button.addEventListener("click", () => setTheme(button.dataset.setTheme));
        });
      })();
    </script>
  </body>
</html>
